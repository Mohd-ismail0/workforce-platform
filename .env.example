# Copy to ~/.config/workforce-platform/database.env (chmod 600) and fill in real values.
# Never commit a populated copy. Both roles are created by the operator on the existing
# PostgreSQL instance; this project never installs or runs a database itself.

# Owner role: applies migrations only. Used by `python3 scripts/dev.py migrate`.
MIGRATION_DATABASE_URL=postgres://workforce_owner:REPLACE_ME@DB_HOST:5432/workforce_platform?sslmode=require

# Runtime role: the API and worker use this. It has no schema-management rights.
DATABASE_URL=postgres://workforce_app:REPLACE_ME@DB_HOST:5432/workforce_platform?sslmode=require

# ---------------------------------------------------------------------------
# Local development authentication. Copy to ~/.config/workforce-platform/local-auth.env
# (chmod 600). AUTH_MODE=local is refused when APP_ENV=production.
# Format: LOCAL_AUTH_TOKENS=<random-token>=<org-id>:<principal-id>:<role>
# Roles: requester | approver | admin.  Generate tokens with: openssl rand -base64 36
# ---------------------------------------------------------------------------
AUTH_MODE=local
APP_ENV=development
LOCAL_AUTH_TOKENS=
HTTP_ADDR=127.0.0.1:8095
